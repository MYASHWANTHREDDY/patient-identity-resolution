# Copy to dbt/profiles.yml (gitignored) or point DBT_PROFILES_DIR at a directory containing
# this file. `dev` runs against local DuckDB; `prod` runs against BigQuery (Phase 11+).
#
# DUCKDB_PATH varies per *data* tier (ci/dev/scale), not per dbt target -- ci and dev both
# use the `dev` dbt target but point at different DuckDB files. Set it before running dbt:
#   DUCKDB_PATH=data/dev/mdm.duckdb dbt run --target dev

mdm:
  target: dev
  outputs:
    dev:
      type: duckdb
      path: "{{ env_var('DUCKDB_PATH', 'data/dev/mdm.duckdb') }}"
      threads: 4

    prod:
      type: bigquery
      method: oauth
      project: "{{ env_var('GCP_PROJECT') }}"
      dataset: conformance
      location: "{{ env_var('GCP_REGION', 'us-central1') }}"
      threads: 8
      # 50 GiB, not the 20 GiB set in Phase 11 -- at the scale tier (5M records),
      # matching.candidate_pairs is ~647M rows, and even a simple structural test
      # (assert_candidate_pairs_ordered_no_self_pairs) needs to scan ~23 GiB of it. The
      # actual dollar cost is trivial (BigQuery on-demand pricing, ~$0.15 for that one
      # query) -- this cap exists to catch a genuinely runaway/mistaken query, not to
      # throttle legitimate scale-tier operations (see docs/scale-run.md).
      maximum_bytes_billed: 53687091200
