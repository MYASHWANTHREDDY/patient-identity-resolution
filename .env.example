# Copy to .env and fill in. Never commit the real .env (see .gitignore).

# Which dataset tier to run against: ci | dev | scale. See config/matching.yml.
MDM_TIER=dev

# GCP — only required from Phase 10 onward (Terraform / BigQuery / Dataproc).
GCP_PROJECT=
GCP_REGION=

# Airflow (Phase 13) — docker-compose.yml reads these. GCS_BUCKET matches Terraform's
# raw_bucket_name output. GOOGLE_APPLICATION_CREDENTIALS_HOST is the path *on your host
# machine* to Application Default Credentials created by `gcloud auth application-default
# login` — never a downloaded service account key (see docs/design-decisions.md).
#   Windows:      C:/Users/<you>/AppData/Roaming/gcloud/application_default_credentials.json
#   macOS/Linux:  /home/<you>/.config/gcloud/application_default_credentials.json
GCS_BUCKET=
GOOGLE_APPLICATION_CREDENTIALS_HOST=
